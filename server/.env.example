# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Supabase PostgreSQL Connection URL)
# Example direct connection: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1

# JWT Settings
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Supabase Auth / Storage integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-or-anon-key

# Email Settings (for nodemailer - Gmail recommended with port 465 SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=smtp-user-id
SMTP_PASS=smtp-user-password
SMTP_FROM=info@shresthaservices.com.np

# Resend HTTP API fallback (bypasses SMTP when smtp.gmail.com is firewalled)
# Get a key at https://resend.com/api-keys - free tier is enough for OTP.
# Without this, OTP still issues instantly but Gmail delivery retries in background.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Shrestha Services <onboarding@resend.dev>
